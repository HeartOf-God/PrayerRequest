# ---- Copy this file to .env and fill in. NEVER commit .env ----
PORT=3000
MAX_FILE_MB=15

# Where prayer requests go (hidden from the website)
PRAYER_EMAIL_TO=you@example.com
WHATSAPP_TO=+91XXXXXXXXXX

# Email via Resend (recommended; required on Render free plan)
RESEND_API_KEY=

# Fallback: Gmail sending account (needs a Gmail "App Password", not your normal password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=you@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx

# WhatsApp provider: callmebot | meta | none
WHATSAPP_PROVIDER=callmebot
CALLMEBOT_APIKEY=

# Only if WHATSAPP_PROVIDER=meta
META_PHONE_NUMBER_ID=
META_ACCESS_TOKEN=
